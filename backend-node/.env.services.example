# Copy to .env.services and fill the provider's SMTP details.
# This local overlay is loaded AFTER .env.staging by the *:services commands.
# Keep the existing AUTH_ENCRYPTION_KEY and database in .env.staging unchanged.
# Restart both API and jobs worker after editing. Nothing reads env edits live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@aqaargate.com
MAIL_FROM_NAME=ProfitLens
MAIL_REPLY_TO=
# Port 587 uses required STARTTLS; port 465 uses implicit TLS.
# MAIL_FROM must be a verified sender address at your provider.
# Quote secrets containing # or whitespace according to Node .env syntax.
AUTH_OTP_PROVIDER=authenticator
AUTH_MOCK_OTP=false

# Onboarding defaults; Super Admin > Registration settings can override these live.
AUTH_EMAIL_VERIFICATION=otp
AUTH_OWNER_PHONE_REQUIRED=false
AUTH_EMAIL_REQUIRED=false
AUTH_WELCOME_EMAIL_ENABLED=false
# MsgPlus approved sender/template for THIS app. No credentials are copied from Jawlaha.
MSGPLUS_API_KEY=
MSGPLUS_SENDER_NAME=
MSGPLUS_TEMPLATE_ID=1
# Match your approved template: code (official example), P1, P2 or P3 (Jawlaha style).
MSGPLUS_VARIABLE_STYLE=code
MSGPLUS_APP_NAME=ProfitLens
