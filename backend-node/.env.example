NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://profitlens:local-development-only@127.0.0.1:55432/profitlens?schema=public&connect_timeout=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
# Integration tests require a dedicated database whose name ends in _test.
TEST_DATABASE_URL=postgresql://profitlens:local-development-only@127.0.0.1:55432/profitlens_test?schema=public&connect_timeout=5

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this key up securely: MFA secrets and mail payloads depend on it.
AUTH_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
# Email is queued transactionally. Configure SMTP and MsgPlus before enabling public signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=ProfitLens
# Optional reply address; leave blank to use the sender.
MAIL_REPLY_TO=

# Separate B2B credentials; never fall back to the legacy AI-assistant PayPal app.
# All four are required together. This enables verified webhook intake only;
# paid checkout/publication remain unavailable pending the remaining billing work.
B2B_PAYPAL_MODE=sandbox
B2B_PAYPAL_CLIENT_ID=
B2B_PAYPAL_CLIENT_SECRET=
B2B_PAYPAL_WEBHOOK_ID=

# Enable only after real sandbox evidence and approved prices. Defaults stay off.
B2B_CHECKOUT_ENABLED=false
B2B_PRICING_APPROVED=false
B2B_SANDBOX_VERIFIED=false
# JSON mapping local immutable plan codes to dedicated B2B PayPal plan IDs.
B2B_PAYPAL_PLAN_BINDINGS={}

# Authenticator-app OTP is built in: no external OTP account or API key.
AUTH_OTP_PROVIDER=authenticator
# Explicit local development/test only. Never enable for deployed environments.
AUTH_MOCK_OTP=false

# Leave unset for direct access. Trust only your reverse proxy's exact IP.
# Compose supplies its pinned edge IP; never use true or a hop count.
# TRUST_PROXY_IP=172.30.86.2

# Onboarding defaults; saved Super Admin settings take precedence.
AUTH_EMAIL_VERIFICATION=otp
AUTH_OWNER_PHONE_REQUIRED=false
# MsgPlus approved sender/template for THIS app. No credentials are copied from Jawlaha.
MSGPLUS_API_KEY=
MSGPLUS_SENDER_NAME=
MSGPLUS_TEMPLATE_ID=1
# Match your approved template: code (official example), P1, P2 or P3 (Jawlaha style).
MSGPLUS_VARIABLE_STYLE=code
MSGPLUS_APP_NAME=ProfitLens

AUTH_EMAIL_REQUIRED=false

AUTH_WELCOME_EMAIL_ENABLED=false
