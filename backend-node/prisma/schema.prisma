generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
// Migration readiness metadata. Business and platform access are enforced
// by their separate authenticated services.
model SystemMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("system_metadata")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}
enum MembershipRole {
  OWNER
  OPERATIONS_MANAGER
  WAREHOUSE_STAFF
  SHOP_MANAGER
  CASHIER
  VIEWER
}
enum AuthTokenKind {
  VERIFY_EMAIL
  PASSWORD_RESET
}
model AuthUser {
  id              String @id @default(uuid()) @db.Uuid
  email           String @unique
  name            String
  passwordHash    String @map("password_hash")
  platformRole    PlatformRole @default(USER) @map("platform_role")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)
  securityVersion Int @default(0) @map("security_version")
  mfaSecret       String? @map("mfa_secret")
  mfaLastStep     BigInt @default(-1) @map("mfa_last_step")
  recoveryHashes String[] @default([]) @map("recovery_hashes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions        AuthSession[]
  tokens          AuthToken[]
  memberships     Membership[]
  @@map("auth_users")
}
model Business {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  salesTaxRate Decimal @default(0) @map("sales_tax_rate") @db.Decimal(7,4)
  baseCurrency String @default("USD") @map("base_currency")
  timezone     String @default("UTC")
  dateFormat   String @default("dmy") @map("date_format")
  numberFormat String @default("western") @map("number_format")
  revision     Int @default(0)
  currencyLockedAt DateTime? @map("currency_locked_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt  DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  Membership[]
  invitations  Invitation[]
  customRoles BusinessRole[]
  subscription BusinessSubscription?
  checkout BillingCheckout?
  locations Location[]
  products Product[]
  productImports ProductImport[]
  suppliers Supplier[]
  paidApprovals PaidApproval[]
  supportTickets SupportTicket[]
  @@map("businesses")
}
model Membership {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  businessId String @map("business_id") @db.Uuid
  role       MembershipRole
  customRoleId String? @map("custom_role_id") @db.Uuid
  customRole BusinessRole? @relation(fields: [businessId, customRoleId], references: [businessId, id], onDelete: NoAction, map: "memberships_custom_role_fkey")
  permissionOverrides Json @default("{}") @map("permission_overrides")
  tabOrder String[] @default([]) @map("tab_order")
  hiddenTabs String[] @default([]) @map("hidden_tabs")
  revision   Int @default(0)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationAssignments LocationAssignment[]
  @@unique([businessId, id])
  @@unique([businessId, userId])
  @@index([userId])
  @@map("memberships")
}
model Location {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  code        String
  name        String
  kind        String
  address     String @default("")
  revision    Int @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignments LocationAssignment[]
  balances StockBalance[]
  movements StockMovement[]
  documents PurchaseDocument[]
  adjustments Adjustment[]
  moneyEntries MoneyEntry[]
  cashCloses CashClose[]
  migrationPreviews MigrationPreview[]
  sales Sale[]
  transfersOut StockTransfer[] @relation("TransferSource")
  transfersIn StockTransfer[] @relation("TransferDestination")
  @@unique([businessId, code])
  @@unique([businessId, id])
  @@index([businessId, archivedAt, kind])
  @@map("locations")
}
model LocationAssignment {
  id           String @id @default(uuid()) @db.Uuid
  businessId   String @map("business_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  location     Location @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  membership   Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Cascade)
  @@unique([locationId, membershipId])
  @@index([businessId, membershipId])
  @@map("location_assignments")
}

model AuthSession {
  id               String @id @default(uuid()) @db.Uuid
  tokenHash        String @unique @map("token_hash")
  userId           String @map("user_id") @db.Uuid
  securityVersion  Int @map("security_version")
  mfaVerified      Boolean @default(false) @map("mfa_verified")
  pendingMfaSecret String? @map("pending_mfa_secret")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  user             AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
model AuthToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id") @db.Uuid
  kind      AuthTokenKind
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, kind])
  @@index([expiresAt])
  @@map("auth_tokens")
}
model Invitation {
  initialPasswordHash String? @map("initial_password_hash")
  name        String? @db.VarChar(100)
  id          String @id @default(uuid()) @db.Uuid
  tokenHash   String @unique @map("token_hash")
  businessId  String @map("business_id") @db.Uuid
  email       String
  role        MembershipRole
  customRoleId String? @map("custom_role_id") @db.Uuid
  customRole BusinessRole? @relation(fields: [businessId, customRoleId], references: [businessId, id], onDelete: NoAction, map: "invitations_custom_role_fkey")
  invitedBy   String @map("invited_by") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, email])
  @@map("invitations")
}
model AuthRateLimit {
  key       String @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("auth_rate_limits")
}
model AuthAudit {
  id         String @id @default(uuid()) @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  action     String
  targetId   String? @map("target_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@map("auth_audit")
}
model AuthMail {
  id            String @id @default(uuid()) @db.Uuid
  payload       String
  attempts      Int @default(0)
  availableAt   DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([deliveredAt, availableAt])
  @@map("auth_mail")
}

// Platform actions are separate from customer-visible business activity.
model PlatformAudit {
  id         String @id @default(uuid()) @db.Uuid
  actorId    String @map("actor_id") @db.Uuid
  targetId   String @map("target_id") @db.Uuid
  targetType String @map("target_type")
  action     String
  reason     String
  beforeActive Boolean @map("before_active")
  afterActive Boolean @map("after_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt, id])
  @@index([targetId, createdAt])
  @@map("platform_audit")
}

model BillingPlan {
  id            String @id @default(uuid()) @db.Uuid
  code          String @unique
  name          String
  nameAr        String @map("name_ar")
  // Null price denotes a trial-only offer, never a free paid subscription.
  priceMinor    Int? @map("price_minor")
  currency      String @default("USD")
  interval      String @default("MONTH")
  trialDays     Int @default(0) @map("trial_days")
  maxMembers    Int @map("max_members")
  maxWarehouses Int @map("max_warehouses")
  maxShops      Int @map("max_shops")
  published     Boolean @default(false)
  revision      Int @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  approvals PaidApproval[]
  subscriptions BusinessSubscription[]
  checkouts BillingCheckout[]
  @@map("billing_plans")
}

model BusinessSubscription {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @unique @map("business_id") @db.Uuid
  planId      String @map("plan_id") @db.Uuid
  status      String @default("TRIAL")
  trialStartedAt DateTime @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt DateTime @map("trial_ends_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        BillingPlan @relation(fields: [planId], references: [id])
  @@map("business_subscriptions")
}

model BillingAudit {
  id         String @id @default(uuid()) @db.Uuid
  actorId    String @map("actor_id") @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  planId     String @map("plan_id") @db.Uuid
  action     String
  changes    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt, id])
  @@map("billing_audit")
}

// Not exposed as a customer checkout route until paid entitlement work is complete.
model BillingCheckout {
  nextBillingAt DateTime? @map("next_billing_at") @db.Timestamptz(3)
  paidFrom DateTime? @map("paid_from") @db.Timestamptz(3)
  paidUntil DateTime? @map("paid_until") @db.Timestamptz(3)
  paidTransaction String? @map("paid_transaction")
  reconciledAt DateTime? @map("reconciled_at") @db.Timestamptz(3)
  accessHold Boolean @default(false) @map("access_hold")
  reconciliationError String? @map("reconciliation_error")
  id                     String @id @default(uuid()) @db.Uuid
  businessId             String @unique @map("business_id") @db.Uuid
  planId                 String @map("plan_id") @db.Uuid
  scope                  String
  providerPlanId         String @map("provider_plan_id")
  providerSubscriptionId String? @map("provider_subscription_id")
  providerStatus         String? @map("provider_status")
  providerUpdatedAt      DateTime? @map("provider_updated_at") @db.Timestamptz(3)
  revision               Int @default(0)
  leaseToken             String? @map("lease_token") @db.Uuid
  leaseUntil             DateTime? @map("lease_until") @db.Timestamptz(3)
  firstRequestedAt       DateTime? @map("first_requested_at") @db.Timestamptz(3)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business               Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan                   BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  receipts               BillingReceipt[]
  cancellation           BillingCancellation?
  @@unique([scope, providerSubscriptionId])
  @@map("billing_checkouts")
}

// A cancellation request survives browser disconnects and ambiguous provider replies.
model BillingCancellation {
  id            String @id @default(uuid()) @db.Uuid
  checkoutId    String @unique @map("checkout_id") @db.Uuid
  actorId       String @map("actor_id") @db.Uuid
  status        String @default("PENDING")
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken    String? @map("lease_token") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  lastError     String? @map("last_error")
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  checkout      BillingCheckout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  @@index([status, nextAttemptAt])
  @@map("billing_cancellations")
}

model BillingWebhook {
  id            String @id @default(uuid()) @db.Uuid
  scope         String
  eventId       String @map("event_id")
  eventType     String @map("event_type")
  payloadHash   String @map("payload_hash")
  payload       String
  status        String @default("PENDING")
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken    String? @map("lease_token") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  lastError     String? @map("last_error")
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([scope, eventId])
  @@index([scope, status, nextAttemptAt])
  @@map("billing_webhooks")
}

// Verified sale receipts only; lifecycle events never become payment rows.
model BillingReceipt {
  id            String @id @default(uuid()) @db.Uuid
  checkoutId    String @map("checkout_id") @db.Uuid
  scope         String
  transactionId String @map("transaction_id")
  eventId       String @map("event_id")
  amountMinor   Int @map("amount_minor")
  currency      String
  paidAt        DateTime @map("paid_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  checkout      BillingCheckout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  @@unique([scope, transactionId])
  @@index([checkoutId, paidAt])
  @@map("billing_receipts")
}


model Product {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  sku String
  name String
  category String @default("")
  subcategory String @default("")
  brand String @default("")
  description String @default("")
  unit String
  purchasePrice Decimal @map("purchase_price") @db.Decimal(18,4)
  sellingPrice Decimal @map("selling_price") @db.Decimal(18,4)
  minimumStock Decimal @default(0) @map("minimum_stock") @db.Decimal(18,4)
  active Boolean @default(true)
  revision Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  barcodes ProductBarcode[]
  images ProductImage[]
  packs ProductPack[]
  balances StockBalance[]
  movements StockMovement[]
  purchaseLines PurchaseLine[]
  transferLines TransferLine[]
  saleLines SaleLine[]
  adjustmentLines AdjustmentLine[]
  @@unique([businessId,sku])
  @@unique([businessId,id])
  @@index([businessId,active,name])
  @@map("products")
}
model ProductBarcode {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  value String
  product Product @relation(fields:[businessId,productId],references:[businessId,id],onDelete:Restrict)
  @@unique([businessId,value])
  @@index([businessId,productId])
  @@map("product_barcodes")
}

model ProductImport {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  currency String
  payload String
  status String @default("PREVIEW")
  rowCount Int @map("row_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  @@index([businessId,actorId,status])
  @@index([status,expiresAt])
  @@map("product_imports")
}


model ProductPack {
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(3)
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  name String
  baseQuantity Decimal @map("base_quantity") @db.Decimal(18,4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product Product @relation(fields:[businessId,productId],references:[businessId,id],onDelete:Restrict)
  saleLines SaleLine[]
  @@unique([businessId,productId,id])
  @@unique([businessId,productId,name])
  @@map("product_packs")
}


model Supplier {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  code String
  name String
  contact String @default("")
  phone String @default("")
  email String @default("")
  address String @default("")
  notes String @default("")
  active Boolean @default(true)
  revision Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  documents PurchaseDocument[]
  @@unique([businessId,id])
  @@unique([businessId,code])
  @@index([businessId,active,name])
  @@map("suppliers")
}
model StockBalance {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  onHand Decimal @default(0) @map("on_hand") @db.Decimal(18,4)
  reserved Decimal @default(0) @db.Decimal(18,4)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  location Location @relation(fields:[businessId,locationId],references:[businessId,id],onDelete:Restrict)
  product Product @relation(fields:[businessId,productId],references:[businessId,id],onDelete:Restrict)
  @@unique([businessId,locationId,productId])
  @@map("stock_balances")
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  type String
  quantity Decimal @db.Decimal(18,4)
  sourceId String @map("source_id") @db.Uuid
  sourceLineId String @map("source_line_id") @db.Uuid
  reference String
  actorId String @map("actor_id") @db.Uuid
  notes String @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  location Location @relation(fields:[businessId,locationId],references:[businessId,id],onDelete:Restrict)
  product Product @relation(fields:[businessId,productId],references:[businessId,id],onDelete:Restrict)
  @@unique([businessId,type,sourceLineId])
  @@index([businessId,locationId,createdAt])
  @@index([businessId,locationId,productId])
  @@map("stock_movements")
}
model PurchaseDocument {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  kind String
  reference String
  clientKey String @map("client_key") @db.Uuid
  requestHash String @map("request_hash")
  status String @default("DRAFT")
  revision Int @default(0)
  orderId String? @map("order_id") @db.Uuid
  supplierName String @map("supplier_name")
  locationName String @map("location_name")
  currency String
  documentDate DateTime @map("document_date") @db.Date
  supplierReference String @default("") @map("supplier_reference")
  notes String @default("")
  actorId String @map("actor_id") @db.Uuid
  actorName String @map("actor_name")
  completedBy String? @map("completed_by") @db.Uuid
  completedName String? @map("completed_name")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  location Location @relation(fields:[businessId,locationId],references:[businessId,id],onDelete:Restrict)
  supplier Supplier @relation(fields:[businessId,supplierId],references:[businessId,id],onDelete:Restrict)
  order PurchaseDocument? @relation("OrderReceipts",fields:[businessId,orderId],references:[businessId,id],onDelete:Restrict)
  receipts PurchaseDocument[] @relation("OrderReceipts")
  lines PurchaseLine[]
  @@unique([businessId,id])
  @@unique([businessId,clientKey])
  @@unique([businessId,reference])
  @@index([businessId,locationId,kind,status])
  @@map("purchase_documents")
}
model PurchaseLine {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku String
  name String
  unit String
  barcodes String[]
  packName String? @map("pack_name")
  factor Decimal @db.Decimal(18,4)
  quantity Decimal @db.Decimal(18,4)
  baseQuantity Decimal @map("base_quantity") @db.Decimal(18,4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18,4)
  unitCost Decimal @map("unit_cost") @db.Decimal(18,4)
  document PurchaseDocument @relation(fields:[businessId,documentId],references:[businessId,id],onDelete:Restrict)
  product Product @relation(fields:[businessId,productId],references:[businessId,id],onDelete:Restrict)
  @@unique([businessId,documentId,productId])
  @@map("purchase_lines")
}


model StockTransfer {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  destinationId String @map("destination_id") @db.Uuid
  sourceName String @map("source_name")
  destinationName String @map("destination_name")
  reference String
  clientKey String @map("client_key") @db.Uuid
  requestHash String @map("request_hash")
  status String @default("DRAFT")
  revision Int @default(0)
  notes String @default("")
  actorId String @map("actor_id") @db.Uuid
  actorName String @map("actor_name")
  dispatchedBy String? @map("dispatched_by") @db.Uuid
