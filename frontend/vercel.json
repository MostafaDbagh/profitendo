{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "REACT_APP_AUTH_API_URL= REACT_APP_BACKEND_URL= REACT_APP_B2B_PRIMARY=true INLINE_RUNTIME_CHUNK=false yarn build",
  "outputDirectory": "build",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow", "X-Content-Type-Options": "nosniff" }, "continue": true },
    { "src": "/api/(.*)", "dest": "https://profitlens-4190.onrender.com/api/$1", "headers": { "Cache-Control": "no-store" } },
    { "src": "/service-worker.js", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "src": "/index.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/(features|pricing|about|en|en/features|en/pricing|en/about)/(?:index\\.html)?", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/(features|pricing|about|en|en/features|en/pricing|en/about)", "dest": "/$1/index.html" },
    { "src": "/(?:auth|auth-v2|business|business-v2|billing-v2|platform-v2|contact)/?", "dest": "/app.html", "headers": { "Cache-Control": "no-store" } },
    { "src": "/sales-v2/[^/]+/[^/]+/receipt/?", "dest": "/app.html", "headers": { "Cache-Control": "no-store" } },
    { "src": "/app.html", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
